# CyberReady Academy — environment template.
# Copy to .env.local for local development:  cp .env.example .env.local
# This file contains PLACEHOLDERS ONLY. Never put real credentials here.

# Public base URL of the site, used for canonical/metadata URLs.
# Required. Must be an absolute http(s) URL.
SITE_URL=http://localhost:3000

